@inherits RequestPageBase
@inject IDashboardApi Saved
<AuthorizeView><Authorized>
    <button class="button-secondary" disabled="@IsBusy" @onclick="Save">@(done ? "Saved — save again to update access" : Pin ? "Pin this list" : "Save this list")</button>
    @if (done) { <a href="/saved">Open saved lists</a> }
    <RequestFeedback Error="@Error" RequiresSignIn="RequiresSignIn" />
</Authorized></AuthorizeView>
@code {
    [Parameter] public Guid ListId { get; set; }
    [Parameter] public string? ShareToken { get; set; }
    [Parameter] public bool Pin { get; set; }
    private bool done;
    private (Guid ListId, string? ShareToken, bool Pin) context;
    protected override void OnParametersSet()
    {
        var next = (ListId, ShareToken, Pin);
        if (context != next) done = false;
        context = next;
    }
    private Task Save() => RunAsync(async () =>
    {
        var saving = context;
        await Saved.SaveAsync(saving.ListId, saving.Pin ? true : null, saving.ShareToken, Cancellation);
        if (context == saving) done = true;
    });
}
