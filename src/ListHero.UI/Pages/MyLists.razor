@page "/lists"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inherits ListHero.UI.Components.OwnerPageBase
@inject NavigationManager Navigation
@inject Microsoft.JSInterop.IJSRuntime JS
@using ListHero.UI.Components

<PageTitle>My lists — List Hero</PageTitle>
<section class="content-page">
    <p class="eyebrow">YOUR HERO HEADQUARTERS</p>
    <h1>My lists</h1>
    <p class="page-introduction">Big dreams, little wishes, and your next great celebration.</p>
    <RequestFeedback Error="@Error" RequiresSignIn="RequiresSignIn" />
    <div class="workspace-grid">
        <div>
            <OwnedListBrowser Page="@Page" PageSize="@PageSize" />
        </div>
        <aside class="form-card">
            <span class="panel-kicker">THE NEXT ADVENTURE</span>
            <h2>Make a new list</h2>
            <p>It starts private. Give it a name that feels like you.</p>
            <DraftRecovery T="CreateWishListRequest" @ref="recovery" Context="new-list" FormId="create-list-form" Label="new list" Model="draft" Restored="RestoreDraft" />
            <EditForm Model="draft" OnValidSubmit="CreateAsync" FormName="create-list" id="create-list-form" data-draft>
                <DataAnnotationsValidator /><ValidationSummary />
                <fieldset disabled="@IsBusy">
                    <label for="list-name">Name</label><InputText id="list-name" @bind-Value="draft.Name" maxlength="200" autocomplete="off" />
                    <label for="list-description">Description</label><InputTextArea id="list-description" @bind-Value="draft.Description" maxlength="4000" rows="4" />
                    <button class="button-primary" type="submit">@(IsBusy ? "Please wait…" : "Create list")</button>
                </fieldset>
            </EditForm>
        </aside>
    </div>
</section>

@code {
    [Parameter, SupplyParameterFromQuery(Name = "page")] public string[]? Page { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "pageSize")] public string[]? PageSize { get; set; }
    private CreateWishListRequest draft = new();
    private DraftRecovery<CreateWishListRequest>? recovery;
    private void RestoreDraft(RecoveredDraft<CreateWishListRequest> value) => draft = value.Model;
    private Task CreateAsync() => RunAsync(async () =>
    {
        var created = await Api.CreateAsync(draft, Cancellation);
        if (recovery is not null) await recovery.ClearAsync();
        await DraftNavigation.AcceptAsync(JS, "create-list-form");
        if (!IsDisposed) Navigation.NavigateTo($"/lists/{created.Id}");
    });
}








